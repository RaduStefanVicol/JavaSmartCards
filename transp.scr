// output on;

// create wallet applet
0x80 0xB8 0x00 0x00 0x14 0x0a 0xa0 0x0 0x0 0x0 0x62 0x3 0x1 0xc 0x6 0x1 0x08 0x0 0x0 0x05 0x01 0x02 0x03 0x04 0x05 0x7F;

//////////////////////////////////////////////////////////////
// Initialize Wallet
//////////////////////////////////////////////////////////////

// Select Wallet
0x00 0xA4 0x04 0x00 0x0a 0xa0 0x0 0x0 0x0 0x62 0x3 0x1 0xc 0x6 0x1 0x7F;
// 90 00 = OK

// Verify PIN
0x80 0x20 0x00 0x00 0x05 0x01 0x02 0x03 0x04 0x05 0x7F;
// 90 00 = OK

// Get balance (initial)
0x80 0x50 0x00 0x00 0x00 0x04;
// 00 00 00 00 00 90 00; balance=0, bus=0, tram=0, dayPass=0

// Credit 103
0x80 0x30 0x00 0x00 0x01 0x67 0x7F;
// 90 00

// Get balance
0x80 0x50 0x00 0x00 0x00 0x04;
// 00 67 00 00 00 90 00; balance=103

// Debit 3 tram tickets 
0x80 0x40 0x01 0x03 0x02 0x05 0x08 0x7F;
// 3 × 2 = 6 so 103 becomes 97
// 90 00

// Get balance
0x80 0x50 0x00 0x00 0x00 0x04;
// 00 61 00 00 00 90 00; balance=97

// Debit 1 tram ticket (Monday 8:00 so no discount)
0x80 0x40 0x01 0x01 0x02 0x00 0x08 0x7F;
// 2 so 97 becomes 95
// 90 00

// Get balance
0x80 0x50 0x00 0x00 0x00 0x04;
// 00 5F 00 00 00 90 00; balance=95

// Debit 2 bus tickets (Friday 11:00 so discount applies)
0x80 0x40 0x00 0x02 0x02 0x04 0x0B 0x7F;
// 2 × 3 = 6 so 95 becomes 89
// 90 00

// Get balance
0x80 0x50 0x00 0x00 0x00 0x04;
// 00 59 00 00 00 90 00; balance=89

// Debit 19 bus tickets (group discount)
0x80 0x40 0x00 0x13 0x02 0x05 0x0D 0x7F;
// 19×4=76; 76 - (76/5=15) = 61 so 89 becomes 28
// 90 00

// Get balance
0x80 0x50 0x00 0x00 0x00 0x04;
// 00 1C 00 00 00 90 00 → balance=28

// Debit 26 tickets ERROR
0x80 0x40 0x01 0x1A 0x02 0x03 0x0D 0x7F;
// 6A 86 (too many tickets)

// Balance unchanged
0x80 0x50 0x00 0x00 0x00 0x04;
// 00 1C 00 00 00 90 00; balance=28

// Credit 100
0x80 0x30 0x00 0x00 0x01 0x64 0x7F;
// 90 00

// Get balance
0x80 0x50 0x00 0x00 0x00 0x04;
// 00 80 00 00 00 90 00; balance=128

// Buy tram pass (40)
0x80 0x70 0x01 0x00 0x00 0x7F;
// 128 becomes 88
// 90 00

// Get balance
0x80 0x50 0x00 0x00 0x00 0x04;
// 00 58 00 1E 00 90 00; balance=88, tram=30

// Buy bus pass (60)
0x80 0x70 0x00 0x00 0x00 0x00;
// 88 becomes 28
// 90 00

// Get balance
0x80 0x50 0x00 0x00 0x00 0x04;
// 00 1C 14 1E 00 90 00; balance=28, bus=20, tram=30

// Use tram pass
0x80 0x40 0x01 0x01 0x02 0x00 0x08 0x7F;
// tramTrips left 29
// 90 00

// Get balance
0x80 0x50 0x00 0x00 0x00 0x04;
// 00 1C 14 1D 00 90 00; tram=29

// Use bus pass
0x80 0x40 0x00 0x01 0x02 0x00 0x0A 0x7F;
// busTrips 19
// 90 00

// Get balance
0x80 0x50 0x00 0x00 0x00 0x04;
// 00 1C 13 1D 00 90 00; bus=19, tram=29

// Buy bus pass (60)
0x80 0x70 0x02 0x00 0x00 0x00;

// Get balance
0x80 0x50 0x00 0x00 0x00 0x04;

// Debit 7 tram tickets 
0x80 0x40 0x01 0x07 0x02 0x05 0x08 0x7F;

// Get balance
0x80 0x50 0x00 0x00 0x00 0x04;