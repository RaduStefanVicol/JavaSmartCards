output on;

// Install / create Wallet applet
0x80 0xB8 0x00 0x00 0x14 0x0A 0xA0 0x00 0x00 0x00 0x62 0x03 0x01 0x0C 0x06 0x01 0x08 0x00 0x00 0x05 0x01 0x02 0x03 0x04 0x05 0x7F;

// Select Wallet
// Expected SW_NO_ERROR = 0x9000
0x00 0xA4 0x04 0x00 0x0A 0xA0 0x00 0x00 0x00 0x62 0x03 0x01 0x0C 0x06 0x01 0x7F;

///////////////////////////////////////////////////
//PIN
// Test PIN verification
// Incorrect PIN, SW_VERIFICATION_FAILED = 0x6300
0x80 0x20 0x00 0x00 0x05 0x01 0x02 0x03 0x04 0x00 0x7F;
// Correct PIN, SW_NO_ERROR = 0x9000
0x80 0x20 0x00 0x00 0x05 0x01 0x02 0x03 0x04 0x05 0x7F;

///////////////////////////////////////////////////
//DEBIT EMPTY
///////////////////////////////////////////////////

// Debit from empty account (RON)
// SW_NEGATIVE_BALANCE = 0x6A85
0x80 0x40 0x00 0x00 0x04 0x00 0x64 0x00 0x00 0x7F;

// Debit from empty account (points)
// SW_INVALID_TRANSACTION_AMOUNT = 0x6A85
0x80 0x40 0x01 0x00 0x04 0x00 0x00 0x00 0x1E 0x7F;

// Debit combined RON + points with empty account
// SW_INVALID_TRANSACTION_AMOUNT = 0x6A85
0x80 0x40 0x02 0x00 0x04 0x00 0x32 0x00 0x0A 0x7F;

///////////////////////////////////////////////////
//CREDIT 
// Credit 100 RON
// SW_NO_ERROR = 0x9000
0x80 0x30 0x00 0x00 0x02 0x00 0x64 0x7F;

// Get balance in RON
// Output: 0x00 0x64 0x9000
0x80 0x50 0x00 0x00 0x01 0x00 0x7F;

// Get balance in points
// Output: 0x05 0x9000
0x80 0x50 0x00 0x00 0x01 0x01 0x7F;

///////////////////////////////////////////////////
//SPENING CREDIT WITH DEBIT
///////////////////////////////////////////////////

// Debit only RON (50)
// SW_NO_ERROR = 0x9000
0x80 0x40 0x00 0x00 0x04 0x00 0x32 0x00 0x00 0x7F;

// Get balances
0x80 0x50 0x00 0x00 0x01 0x00 0x7F; // RON
0x80 0x50 0x00 0x00 0x01 0x01 0x7F; // Points

///////////////////////////////////////////////////
//DEBIT TESTS
///////////////////////////////////////////////////

// Debit only points (insufficient)
// SW_INVALID_TRANSACTION_AMOUNT = 0x6A85
0x80 0x40 0x01 0x00 0x04 0x00 0x00 0x00 0x1E 0x7F;

// Get points balance
0x80 0x50 0x00 0x00 0x01 0x01 0x7F;

// Debit only points (sufficient)
// SW_NO_ERROR = 0x9000
0x80 0x40 0x01 0x00 0x04 0x00 0x00 0x00 0x05 0x7F;

// Get points balance
0x80 0x50 0x00 0x00 0x01 0x01 0x7F;

// Debit combined RON + points
// Example: Buy 60 using 50 RON + 10 points
0x80 0x40 0x02 0x00 0x04 0x00 0x32 0x00 0x0A 0x7F;

// Get balances
0x80 0x50 0x00 0x00 0x01 0x00 0x7F;
0x80 0x50 0x00 0x00 0x01 0x01 0x7F;

// Debit combined RON + points (insufficient RON)
// SW_INVALID_TRANSACTION_AMOUNT = 0x6A85
0x80 0x40 0x02 0x00 0x04 0x00 0x64 0x00 0x05 0x7F;

// Debit combined RON + points (insufficient points)
// SW_INVALID_TRANSACTION_AMOUNT = 0x6A85
0x80 0x40 0x02 0x00 0x04 0x00 0x32 0x00 0x10 0x7F;

////////////////////////////////////
// Credit 200 RON
////////////////////////////////////
// SW_NO_ERROR = 0x9000
0x80 0x30 0x00 0x00 0x02 0x00 0xC8 0x7F;

// Get balances
0x80 0x50 0x00 0x00 0x01 0x00 0x7F; // RON
0x80 0x50 0x00 0x00 0x01 0x01 0x7F; // Points

////////////////////////////////////
// Debit 150 RON (>127)
////////////////////////////////////

// SW_NO_ERROR = 0x9000
0x80 0x40 0x00 0x00 0x04 0x00 0x96 0x00 0x00 0x7F;

////////////////////////////////////
// Test max transaction limit
// SW_INVALID_TRANSACTION_AMOUNT = 0x6A83
0x80 0x30 0x00 0x00 0x02 0x03 0xE8 0x7F;

// Test max loyalty points limit
// Credit 600 RON, points capped at 300
0x80 0x30 0x00 0x00 0x02 0x02 0x58 0x7F;

output off;